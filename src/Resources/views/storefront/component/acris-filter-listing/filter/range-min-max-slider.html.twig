{% set filterItemId = 'filter-' ~ name ~ '-' ~ random() %}
{% set propertyId = property.id %}

{% if currencySymbol is not defined %}
    {% if property.translated.customFields.acris_filter_unit %}
        {% set currencySymbol = property.translated.customFields.acris_filter_unit %}
    {% else %}
        {% set currencySymbol = context.currency.symbol %}
    {% endif %}
{% endif %}

{% set minMaxLayout = config('AcrisFilterCS.config.minMaxFilterInput') %}

{% set minElementValue = null %}
{% set maxElementValue = null %}
{% for element in elements %}
    {% if minElementValue is null or element.translated.customFields.acris_filter_numeric < minElementValue %}
        {% set minElementValue = element.translated.customFields.acris_filter_numeric %}
    {% endif %}

    {% if maxElementValue is null or element.translated.customFields.acris_filter_numeric > maxElementValue %}
        {% set maxElementValue = element.translated.customFields.acris_filter_numeric %}
    {% endif %}
{% endfor %}
{% if minElementValue == null %}{% set minElementValue = 0 %}{% endif %}
{% if maxElementValue == null %}{% set maxElementValue = 0 %}{% endif %}

{% if filterRangeActiveMinLabel is not defined %}
    {% set filterRangeActiveMinLabel = 'acrisFilter.filterRangeActiveMinLabel'|trans({
        '%displayName%': displayName
    })|sw_sanitize %}
{% endif %}

{% if filterRangeActiveMaxLabel is not defined %}
    {% set filterRangeActiveMaxLabel = 'acrisFilter.filterRangeActiveMaxLabel'|trans({
        '%displayName%': displayName
    })|sw_sanitize %}
{% endif %}

{% if filterRangeErrorMessage is not defined %}
    {% set filterRangeErrorMessage = 'listing.filterRangeErrorMessage'|trans|sw_sanitize %}
{% endif %}

{% set minKey = minKey~'['~propertyId~']' %}
{% set maxKey = maxKey~'['~propertyId~']' %}
{% set queryParams = app.request.query.all() %}

{# the query values are rendered into the filter, so only accept plain numbers #}
{% if queryParams %}
    {% if queryParams['min-property'] %}
        {% set rawMinValue = queryParams['min-property'][propertyId]|default(null) %}
        {% if rawMinValue is not null and rawMinValue is not iterable and rawMinValue matches '/^-?\\d+(?:\\.\\d+)?$/' %}
            {% set currentMinValue = rawMinValue %}
        {% endif %}
    {% endif %}
{% endif %}
{% if queryParams %}
    {% if queryParams['max-property'] %}
        {% set rawMaxValue = queryParams['max-property'][propertyId]|default(null) %}
        {% if rawMaxValue is not null and rawMaxValue is not iterable and rawMaxValue matches '/^-?\\d+(?:\\.\\d+)?$/' %}
            {% set currentMaxValue = rawMaxValue %}
        {% endif %}
    {% endif %}
{% endif %}

{% set filterRangeMinMaxSliderOptions = {
    name: displayName,
    selector: 'range-slider-' ~ propertyId,
    minKey: minKey,
    maxKey: maxKey,
    minValue: minElementValue,
    maxValue: maxElementValue,
    currentMinValue: currentMinValue,
    currentMaxValue: currentMaxValue,
    currencySymbol: currencySymbol,
    snippets: {
        filterRangeActiveMinLabel: filterRangeActiveMinLabel,
        filterRangeActiveMaxLabel: filterRangeActiveMaxLabel,
        filterRangeErrorMessage: filterRangeErrorMessage
    },
    propertyId: propertyId,
    dummyFilter: dummyFilter,
    filterId: 'filter-' ~ displayName,
    numberFormat: property.translated.customFields.acris_filter_number_format ?? 'auto'
} %}

{% block component_filter_range_min_max_slider %}
    <div class="filter-range filter-panel-item{% if isOffcanvas == false and sidebar %} d-grid{% elseif isOffcanvas == false and sidebar == false %} dropdown{% endif %}"
            {% if dummyFilter %}
                {% set filterRangeMinMaxSliderOptions = filterRangeMinMaxSliderOptions |merge ({
                    filterType: 'rangeMinMaxSlider',
                    displayName: displayName,
                    filterId: 'filter-' ~ displayName
                }) %}
                data-acris-filter-dummy-offcanvas="true"
                data-acris-filter-dummy-offcanvas-options='{{ filterRangeMinMaxSliderOptions|json_encode }}'
            {% else %}
                data-acris-filter-range-min-max-slider="true"
                data-acris-filter-range-min-max-slider-options='{{ filterRangeMinMaxSliderOptions|json_encode }}'
                data-filter-id="{{ 'filter-' ~ displayName }}"
            {% endif %}
    >

        {% block component_filter_range_min_max_slider_toggle %}
            <button class="range-slider-{{ propertyId }} filter-panel-item-toggle property-range-slider-{{ displayName|replace({' ': ''}) }} btn"
                    aria-expanded="false"
                    id="range-slider-{{ propertyId }}"
                    {% if config('AcrisFilterCS.config.filterDisplayOffcanvas') == 'accordion' and isOffcanvas or sidebar %}
                data-bs-toggle="collapse"
                data-bs-target="#{{ filterItemId }}"
            {% else %}
                data-bs-toggle="dropdown"
                data-boundary="viewport"
                data-bs-offset="0,8"
                aria-haspopup="true"
                    {% endif %}>

                {% block component_filter_range_min_max_slider_display_name %}
                    {{ displayName }}
                {% endblock %}

                {% block component_filter_range_min_max_slider_toggle_icon %}
                    {% sw_icon 'arrow-medium-down' style {'pack': 'solid', 'size': 'xs', 'class': 'filter-panel-item-toggle'} %}
                {% endblock %}
            </button>
        {% endblock %}

        {% block component_filter_range_min_max_slider_dropdown %}
            <div class="filter-range-dropdown filter-range-slider-dropdown filter-panel-item-dropdown acris-filter-min-max-slider{% if config('AcrisFilterCS.config.filterDisplayOffcanvas') == 'accordion' and isOffcanvas or sidebar %} collapse{% else %} dropdown-menu{% endif %}"
                    id="{{ filterItemId }}">

                <div class="d-block">
                    {% block component_filter_range_min_max_slider_container %}
                        <div class="filter-range-container" data-property-id="{{ propertyId }}">
                            {% block component_filter_range_min_max_slider_min %}
                                <label class="filter-range-min">

                                    {% block component_filter_range_min_max_slider_min_label %}
                                        {{ 'listing.filterRangeMinLabel'|trans|sw_sanitize }}{% if minMaxLayout == 'bigger_input' and currencySymbol %} ({{ currencySymbol }}){% endif %}
                                    {% endblock %}

                                    {% block component_filter_range_min_max_slider_min_input %}
                                        <input class="form-control min-max-input-min"
                                               type="number"
                                               data-type="min"
                                               name="min-property[{{ propertyId }}]"
                                               min="{{ minElementValue }}"
                                               placeholder="{{ minElementValue }}"
                                               max="{{ maxElementValue }}">
                                    {% endblock %}

                                    {% block component_filter_range_min_max_slider_min_currency_symbol %}
                                        {% if minMaxLayout != 'bigger_input' %}
                                            <span class="filter-range-unit">
                                    {{ currencySymbol }}
                                    </span>
                                        {% endif %}
                                    {% endblock %}
                                </label>
                            {% endblock %}

                            {% block component_filter_range_min_max_slider_divider %}
                                <div class="filter-range-divider">
                                    &ndash;
                                </div>
                            {% endblock %}

                            {% block acris_component_filter_hidden_display_name %}
                                <input type="hidden" name="displayName" value="{{ displayName }}">
                            {% endblock %}

                            {% block component_filter_range_min_max_slider_max %}
                                <label class="filter-range-max">

                                    {% block component_filter_range_min_max_slider_max_label %}
                                        {{ 'listing.filterRangeMaxLabel'|trans|sw_sanitize }}{% if minMaxLayout == 'bigger_input' and currencySymbol %} ({{ currencySymbol }}){% endif %}
                                    {% endblock %}
                                    {% block component_filter_range_min_max_slider_max_input %}
                                        <input class="form-control min-max-input-max"
                                               type="number"
                                               data-type="max"
                                               name="max-property[{{ propertyId }}]"
                                               min="{{ minElementValue }}"
                                               placeholder="{{ maxElementValue }}"
                                               max="{{ maxElementValue }}">
                                    {% endblock %}

                                    {% block component_filter_range_min_max_slider_max_currency_symbol %}
                                        {% if minMaxLayout != 'bigger_input' %}
                                            <span class="filter-range-unit">
                                        {{ currencySymbol }}
                                    </span>
                                        {% endif %}
                                    {% endblock %}
                                </label>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block component_filter_range_min_max_slider_slider %}
                        {{ block('component_filter_range_slider_container', '@AcrisFilterCS/storefront/component/acris-filter-listing/filter/range-slider.html.twig') }}
                    {% endblock %}
                </div>
            </div>
        {% endblock %}

    </div>
{% endblock %}
