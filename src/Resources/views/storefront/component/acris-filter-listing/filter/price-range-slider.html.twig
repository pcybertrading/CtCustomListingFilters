{% set filterItemId = 'filter-' ~ name ~ '-' ~ random() %}

{% if currencySymbol is not defined %}
    {% set currencySymbol = context.currency.symbol %}
{% endif %}

{% if price.min and price.min >= 0 %}
    {% set minValue = price.min|round(0, 'floor') %}
{% else %}
    {% set minValue = 0 %}
{% endif %}
{% if price.max %}
    {% set maxValue = price.max|round(0, 'ceil') %}
{% endif %}

{% set queryParams = app.request.query.all() %}

{% if queryParams %}
    {% if queryParams['min-price'] %}
        {% set currentMinValue = queryParams['min-price']|round(0, 'floor') %}
    {% endif %}
{% endif %}
{% if queryParams %}
    {% if queryParams['max-price'] %}
        {% set currentMaxValue = queryParams['max-price']|round(0, 'ceil') %}
    {% endif %}
{% endif %}

{% set minElementValue = minValue %}
{% set maxElementValue = maxValue %}
{% set queryParams = app.request.query.all() %}

{% if queryParams %}
    {% if queryParams['min-price'] %}
        {% set currentMinValue = queryParams['min-price']|round(0, 'floor') %}
        {% set minElementValue = currentMinValue %}
    {% endif %}
{% endif %}
{% if queryParams %}
    {% if queryParams['max-price'] %}
        {% set currentMaxValue = queryParams['max-price']|round(0, 'ceil') %}
        {% set maxElementValue = currentMaxValue %}
    {% endif %}
{% endif %}

{% if minElementValue is null %}{% set minElementValue = 0 %}{% endif %}
{% if maxElementValue is null %}{% set maxElementValue = 0 %}{% endif %}

{% if filterRangeActiveMinLabel is not defined %}
    {% set filterRangeActiveMinLabel = 'listing.filterRangeActiveMinLabel'|trans({
        '%displayName%': displayName
    })|sw_sanitize %}
{% endif %}

{% if filterRangeActiveMaxLabel is not defined %}
    {% set filterRangeActiveMaxLabel = 'listing.filterRangeActiveMaxLabel'|trans({
        '%displayName%': displayName
    })|sw_sanitize %}
{% endif %}

{% if filterRangeErrorMessage is not defined %}
    {% set filterRangeErrorMessage = 'listing.filterRangeErrorMessage'|trans|sw_sanitize %}
{% endif %}

{% set propertyId = 'price-range-min-max' %}

{% set filterRangeOptions = {
    name: name,
    selector: 'price-range-slider',
    minKey: minKey,
    maxKey: maxKey,
    minValue: minValue,
    maxValue: maxValue,
    currentMinValue: currentMinValue,
    currentMaxValue: currentMaxValue,
    currencySymbol: currencySymbol,
    snippets: {
        filterRangeActiveMinLabel: filterRangeActiveMinLabel,
        filterRangeActiveMaxLabel: filterRangeActiveMaxLabel,
        filterRangeErrorMessage: filterRangeErrorMessage
    },
    propertyId: propertyId,
    dummyFilter: dummyFilter,
    filterId: 'filter-' ~ displayName
} %}

{% block component_filter_range %}
    <div class="filter-range-slider filter-panel-item{% if filterType == 'range_min_max_slider' %} acris-filter-min-max-slider{% endif %}{% if isOffcanvas == false and sidebar %} d-grid{% elseif isOffcanvas == false and sidebar == false %} dropdown{% endif %}"
            {% if filterType == 'range_min_max_slider' %}
                {% if dummyFilter %}
                    {% set filterRangeOptions = filterRangeOptions |merge ({
                        filterType: 'rangeMinMaxSlider',
                        displayName: displayName,
                        filterId: 'filter-' ~ displayName
                    }) %}
                    data-acris-filter-dummy-offcanvas="true"
                    data-acris-filter-dummy-offcanvas-options='{{ filterRangeOptions|json_encode }}'
                {% else %}
                    data-acris-filter-range-min-max-slider="true"
                    data-acris-filter-range-min-max-slider-options='{{ filterRangeOptions|json_encode }}'
                    data-filter-id="{{ 'filter-' ~ displayName }}"
                {% endif %}
            {% else %}
                {% if dummyFilter %}
                    {% set filterRangeOptions = filterRangeOptions |merge ({
                        filterType: 'rangeSlider',
                        displayName: displayName,
                        filterId: 'filter-' ~ displayName
                    }) %}
                    data-acris-filter-dummy-offcanvas="true"
                    data-acris-filter-dummy-offcanvas-options='{{ filterRangeOptions|json_encode }}'
                {% else %}
                    data-acris-filter-range-slider="true"
                    data-acris-filter-range-slider-options='{{ filterRangeOptions|json_encode }}'
                    data-filter-id="{{ 'filter-' ~ displayName }}"
                {% endif %}

            {% endif %}
    >

        {% block component_filter_range_toggle %}
            <button class="price-range-slider filter-panel-item-toggle btn"
                    aria-expanded="false"
                    id="price-range-slider"
                    {% if config('AcrisFilterCS.config.filterDisplayOffcanvas') == 'accordion' and isOffcanvas or sidebar %}
                data-bs-toggle="collapse"
                data-bs-target="#{{ filterItemId }}"
            {% else %}
                data-bs-toggle="dropdown"
                data-boundary="viewport"
                data-bs-offset="0,8"
                aria-haspopup="true"
                    {% endif %}>

                {% block component_filter_range_display_name %}
                    {{ displayName }}
                {% endblock %}

                {% block component_filter_range_toggle_icon %}
                    {% sw_icon 'arrow-medium-down' style {'pack': 'solid', 'size': 'xs', 'class': 'filter-panel-item-toggle'} %}
                {% endblock %}
            </button>
        {% endblock %}

        {% block component_filter_range_dropdown %}
            <div class="filter-range-slider-dropdown filter-panel-item-dropdown{% if config('AcrisFilterCS.config.filterDisplayOffcanvas') == 'accordion' and isOffcanvas or sidebar %} collapse{% else %} dropdown-menu{% endif %}"
                 id="{{ filterItemId }}">

                {% if filterType == 'range_min_max_slider' %}
                <div class="d-block">
                    {% block component_filter_range_min_max_input %}

                        {{ block('component_filter_range_min_max_slider_container', '@AcrisFilterCS/storefront/component/acris-filter-listing/filter/range-min-max-slider.html.twig') }}

                    {% endblock %}
                    {% endif %}

                    {% block component_filter_range_container %}
                        <div class="filter-range-slider-container w-100" data-name="{{ displayName }}">

                            {% block component_filter_range_min_input %}
                                <input class="form-control min-input"
                                       type="hidden"
                                       name="min-price"
                                >
                            {% endblock %}

                            {% block component_filter_range_max_input %}
                                <input class="form-control max-input"
                                       type="hidden"
                                       name="max-price"
                                >
                            {% endblock %}

                            {% block component_filter_range_slider_wrapper %}
                                <div class="acris-range-slider range-slider">
                                    {% block component_filter_range_slider_wrapper_bar %}
                                        <div class="range-slider-bar">
                                            {% block component_filter_range_slider_wrapper_handler %}
                                                <div class="range-slider-button range-slider-button-left"></div>
                                                <div class="range-slider-button range-slider-button-right"></div>
                                            {% endblock %}
                                        </div>
                                    {% endblock %}
                                </div>
                            {% endblock %}

                            {% block component_filter_range_slider_info %}
                                <div class="acris-range-slider-info">
                                    {% block component_filter_range_slider_info_from %}
                                        <span
                                                class="acris-range-info-from">{{ 'acrisFilter.filterRangeSliderFrom'|trans|sw_sanitize }}</span>
                                        <span class="acris-range-info-value">
                                        <span id="acris-range-info-min"
                                              class="acris-range-info-value-from">{% if currentMinValue %}{{ currentMinValue }}{% else %}{{ minValue }}{% endif %}</span> {{ currencySymbol }}
                                    </span>
                                    {% endblock %}

                                    {% block component_filter_range_slider_info_to %}
                                        <span
                                                class="acris-range-info-to">{{ 'acrisFilter.filterRangeSliderTo'|trans|sw_sanitize }}</span>
                                        <span class="acris-range-info-value">
                                        <span id="acris-range-info-max"
                                              class="acris-range-info-value-to">{% if currentMaxValue %}{{ currentMaxValue }}{% else %}{{ maxValue }}{% endif %}</span> {{ currencySymbol }}
                                    </span>
                                    {% endblock %}
                                </div>
                            {% endblock %}

                        </div>
                    {% endblock %}

                    {% if filterType == 'range_min_max_slider' %}
                </div>
                {% endif %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
