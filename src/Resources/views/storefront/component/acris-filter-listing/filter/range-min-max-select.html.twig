{% set filterItemId = 'filter-' ~ name ~ '-' ~ random() %}
{% set propertyId = property.id %}

{% if currencySymbol is not defined %}
    {% if property.translated.customFields.acris_filter_unit %}
        {% set currencySymbol = property.translated.customFields.acris_filter_unit %}
    {% else %}
        {% set currencySymbol = context.currency.symbol %}
    {% endif %}
{% endif %}

{% set minMaxLayout = config('AcrisFilterCS.config.minMaxFilterInput') %}

{% set minElementValue = null %}
{% set maxElementValue = null %}
{% for element in elements %}
    {% if minElementValue is null or element.translated.customFields.acris_filter_numeric < minElementValue %}
        {% set minElementValue = element.translated.customFields.acris_filter_numeric %}
    {% endif %}

    {% if maxElementValue is null or element.translated.customFields.acris_filter_numeric_max > maxElementValue %}
        {% set maxElementValue = element.translated.customFields.acris_filter_numeric_max|round(1, 'ceil') %}
    {% elseif maxElementValue is null or element.translated.customFields.acris_filter_numeric > maxElementValue %}
        {% set maxElementValue = element.translated.customFields.acris_filter_numeric|round(1, 'ceil') %}
    {% endif %}
{% endfor %}
{% if minElementValue is null %}{% set minElementValue = 0 %}{% endif %}
{% if maxElementValue is null %}{% set maxElementValue = 0 %}{% endif %}

{% if filterRangeActiveMinLabel is not defined %}
    {% set filterRangeActiveMinLabel = 'acrisFilter.filterRangeActiveMinLabel'|trans({
        '%displayName%': displayName
    })|sw_sanitize %}
{% endif %}

{% if filterRangeActiveMaxLabel is not defined %}
    {% set filterRangeActiveMaxLabel = 'acrisFilter.filterRangeActiveMaxLabel'|trans({
        '%displayName%': displayName
    })|sw_sanitize %}
{% endif %}

{% if filterRangeErrorMessage is not defined %}
    {% set filterRangeErrorMessage = 'listing.filterRangeErrorMessage'|trans|sw_sanitize %}
{% endif %}

{% set minKey = minKey~'['~propertyId~']' %}
{% set maxKey = maxKey~'['~propertyId~']' %}



{% set filterRangeOptions = {
    name: displayName,
    minKey: minKey,
    maxKey: maxKey,
    minValue: minElementValue,
    maxValue: maxElementValue,
    currencySymbol: currencySymbol,
    snippets: {
        filterRangeActiveMinLabel: filterRangeActiveMinLabel,
        filterRangeActiveMaxLabel: filterRangeActiveMaxLabel,
        filterRangeErrorMessage: filterRangeErrorMessage
    },
    propertyId: propertyId,
    dummyFilter: dummyFilter,
    filterId: 'filter-' ~ displayName,
} %}

{% block component_filter_range %}
    <div class="filter-range filter-panel-item{% if isOffcanvas == false and sidebar %} d-grid{% elseif isOffcanvas == false and sidebar == false %} dropdown{% endif %}"
            {% if dummyFilter %}
                {% set filterRangeOptions = filterRangeOptions |merge ({
                    filterType: 'min-max'
                }) %}
                data-acris-filter-dummy-offcanvas="true"
                data-acris-filter-dummy-offcanvas-options='{{ filterRangeOptions|json_encode }}'
            {% else %}
                data-acris-filter-range="true"
                data-acris-filter-range-options='{{ filterRangeOptions|json_encode }}'
                data-property-id="{{ propertyId }}"
            {% endif %}
    >

        {% block component_filter_range_toggle %}
            <button class="filter-panel-item-toggle btn"
                    aria-expanded="false"
                    {% if config('AcrisFilterCS.config.filterDisplayOffcanvas') == 'accordion' and isOffcanvas or sidebar %}
                data-bs-toggle="collapse"
                data-bs-target="#{{ filterItemId }}"
            {% else %}
                data-bs-toggle="dropdown"
                data-boundary="viewport"
                data-bs-offset="0,8"
                aria-haspopup="true"
                    {% endif %}>

                {% block component_filter_range_display_name %}
                    {{ displayName }}
                {% endblock %}

                {% block component_filter_range_toggle_icon %}
                    {% sw_icon 'arrow-medium-down' style {'pack': 'solid', 'size': 'xs', 'class': 'filter-panel-item-toggle'} %}
                {% endblock %}
            </button>
        {% endblock %}

        {% block component_filter_range_dropdown %}
            <div class="filter-range-dropdown filter-panel-item-dropdown{% if config('AcrisFilterCS.config.filterDisplayOffcanvas') == 'accordion' and isOffcanvas or sidebar %} collapse{% else %} dropdown-menu{% endif %}" id="{{ filterItemId }}">

                {% block component_filter_range_container %}
                    <div class="filter-range-container">
                        {% block component_filter_range_min %}
                            <label class="filter-range-min">

                                {% block component_filter_range_min_label %}
                                    {{ 'listing.filterRangeMinLabel'|trans|sw_sanitize }}{% if minMaxLayout == 'bigger_input' and currencySymbol %} ({{ currencySymbol }}){% endif %}
                                {% endblock %}

                                {% block component_filter_range_min_input %}
                                    <input class="form-control min-input"
                                           type="number"
                                           name="min-property[{{ propertyId }}]"
                                           min="{{ minElementValue }}"
                                           placeholder="{{ minElementValue }}"
                                           max="{{ maxElementValue }}">
                                {% endblock %}

                                {% block component_filter_range_min_currency_symbol %}
                                    {% if minMaxLayout != 'bigger_input' %}
                                        <span class="filter-range-currency-symbol">
                                    {{ currencySymbol }}
                                    </span>
                                    {% endif %}
                                {% endblock %}
                            </label>
                        {% endblock %}

                        {% block component_filter_range_divider %}
                            <div class="filter-range-divider">
                                &ndash;
                            </div>
                        {% endblock %}

                        {% block acris_component_filter_hidden_display_name %}
                            <input type="hidden" name="displayName" value="{{ displayName }}">
                        {% endblock %}

                        {% block component_filter_range_max %}
                            <label class="filter-range-max">

                                {% block component_filter_range_max_label %}
                                    {{ 'listing.filterRangeMaxLabel'|trans|sw_sanitize }}{% if minMaxLayout == 'bigger_input' and currencySymbol %} ({{ currencySymbol }}){% endif %}
                                {% endblock %}
                                {% block component_filter_range_max_input %}
                                    <input class="form-control max-input"
                                           type="number"
                                           name="max-property[{{ propertyId }}]"
                                           min="{{ minElementValue }}"
                                           placeholder="{{ maxElementValue }}"
                                           max="{{ maxElementValue }}">
                                {% endblock %}

                                {% block component_filter_range_max_currency_symbol %}
                                    {% if minMaxLayout != 'bigger_input' %}
                                        <span class="filter-range-currency-symbol">
                                        {{ currencySymbol }}
                                    </span>
                                    {% endif %}
                                {% endblock %}
                            </label>
                        {% endblock %}
                    </div>
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
