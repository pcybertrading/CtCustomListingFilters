{% set filterItemId = 'filter-' ~ identifier ~ '-' ~ random() %}
{% set minMaxLayout = config('AcrisFilterCS.config.minMaxFilterInput') %}
{# units are fixed by the product measure fields, same as in the administration product detail page #}
{% set unitLabel = identifier == 'weight' ? 'kg' : 'mm' %}

{% set minValue = stats.min ? stats.min|round(1, 'floor') : 0 %}
{% set maxValue = stats.max ? stats.max|round(1, 'ceil') : 0 %}

{% set minKey = 'min-' ~ identifier %}
{% set maxKey = 'max-' ~ identifier %}

{% set queryParams = app.request.query.all() %}

{# the query values are rendered into the filter inputs, so only accept plain numbers #}
{% set rawMinValue = queryParams[minKey]|default(null) %}
{% set rawMaxValue = queryParams[maxKey]|default(null) %}

{% set currentMinValue = null %}
{% if rawMinValue is not null and rawMinValue is not iterable and rawMinValue matches '/^-?\\d+(?:\\.\\d+)?$/' %}
    {% set currentMinValue = rawMinValue %}
{% endif %}

{% set currentMaxValue = null %}
{% if rawMaxValue is not null and rawMaxValue is not iterable and rawMaxValue matches '/^-?\\d+(?:\\.\\d+)?$/' %}
    {% set currentMaxValue = rawMaxValue %}
{% endif %}

{% if filterRangeActiveMinLabel is not defined %}
    {% set filterRangeActiveMinLabel = 'listing.filterRangeActiveMinLabel'|trans({
        '%displayName%': displayName
    })|sw_sanitize %}
{% endif %}

{% if filterRangeActiveMaxLabel is not defined %}
    {% set filterRangeActiveMaxLabel = 'listing.filterRangeActiveMaxLabel'|trans({
        '%displayName%': displayName
    })|sw_sanitize %}
{% endif %}

{% if filterRangeErrorMessage is not defined %}
    {% set filterRangeErrorMessage = 'listing.filterRangeErrorMessage'|trans|sw_sanitize %}
{% endif %}

{% set filterRangeOptions = {
    name: displayName,
    selector: identifier ~ '-range-slider',
    statsKey: identifier,
    minKey: minKey,
    maxKey: maxKey,
    minValue: minValue,
    maxValue: maxValue,
    currentMinValue: currentMinValue,
    currentMaxValue: currentMaxValue,
    currencySymbol: unitLabel,
    snippets: {
        filterRangeActiveMinLabel: filterRangeActiveMinLabel,
        filterRangeActiveMaxLabel: filterRangeActiveMaxLabel,
        filterRangeErrorMessage: filterRangeErrorMessage
    },
    propertyId: identifier,
    dummyFilter: dummyFilter,
    filterId: 'filter-' ~ identifier
} %}

{% if filterType == 'range_slider' %}
    {% set dummyFilterType = 'rangeSlider' %}
{% elseif filterType == 'range_min_max_slider' %}
    {% set dummyFilterType = 'rangeMinMaxSlider' %}
{% else %}
    {% set filterType = 'range_min_max' %}
    {% set dummyFilterType = 'min-max' %}
{% endif %}

{% block component_acris_filter_product_range %}
    <div class="{% if filterType == 'range_min_max' %}filter-range{% else %}filter-range-slider{% endif %} filter-panel-item{% if filterType == 'range_min_max_slider' %} acris-filter-min-max-slider{% endif %}{% if isOffcanvas == false and sidebar %} d-grid{% elseif isOffcanvas == false and sidebar == false %} dropdown{% endif %}"
            {% if dummyFilter %}
                {% set filterRangeOptions = filterRangeOptions|merge({
                    filterType: dummyFilterType,
                    displayName: displayName
                }) %}
                data-acris-filter-dummy-offcanvas="true"
                data-acris-filter-dummy-offcanvas-options='{{ filterRangeOptions|json_encode }}'
            {% elseif filterType == 'range_min_max' %}
                data-acris-filter-range="true"
                data-acris-filter-range-options='{{ filterRangeOptions|json_encode }}'
                data-property-id="{{ identifier }}"
            {% elseif filterType == 'range_min_max_slider' %}
                data-acris-filter-range-min-max-slider="true"
                data-acris-filter-range-min-max-slider-options='{{ filterRangeOptions|json_encode }}'
                data-filter-id="{{ 'filter-' ~ identifier }}"
                data-property-id="{{ identifier }}"
            {% else %}
                data-acris-filter-range-slider="true"
                data-acris-filter-range-slider-options='{{ filterRangeOptions|json_encode }}'
                data-filter-id="{{ 'filter-' ~ identifier }}"
            {% endif %}
    >

        {% block component_acris_filter_product_range_toggle %}
            <button class="{{ identifier }}-range-slider filter-panel-item-toggle btn"
                    aria-expanded="false"
                    id="{{ identifier }}-range-slider"
                    {% if config('AcrisFilterCS.config.filterDisplayOffcanvas') == 'accordion' and isOffcanvas or sidebar %}
                data-bs-toggle="collapse"
                data-bs-target="#{{ filterItemId }}"
            {% else %}
                data-bs-toggle="dropdown"
                data-boundary="viewport"
                data-bs-offset="0,8"
                aria-haspopup="true"
                    {% endif %}>

                {% block component_acris_filter_product_range_display_name %}
                    {{ displayName }}
                {% endblock %}

                {% block component_acris_filter_product_range_toggle_icon %}
                    {% sw_icon 'arrow-medium-down' style {'pack': 'solid', 'size': 'xs', 'class': 'filter-panel-item-toggle'} %}
                {% endblock %}
            </button>
        {% endblock %}

        {% block component_acris_filter_product_range_dropdown %}
            <div class="filter-range-dropdown{% if filterType != 'range_min_max' %} filter-range-slider-dropdown{% endif %} filter-panel-item-dropdown{% if filterType == 'range_min_max_slider' %} acris-filter-min-max-slider{% endif %}{% if config('AcrisFilterCS.config.filterDisplayOffcanvas') == 'accordion' and isOffcanvas or sidebar %} collapse{% else %} dropdown-menu{% endif %}"
                 id="{{ filterItemId }}">

                <div class="d-block">
                    {% if filterType != 'range_slider' %}
                        {% block component_acris_filter_product_range_inputs %}
                            <div class="filter-range-container">
                                {% block component_acris_filter_product_range_min %}
                                    <label class="filter-range-min">
                                        {% block component_acris_filter_product_range_min_label %}
                                            {{ 'listing.filterRangeMinLabel'|trans|sw_sanitize }}{% if minMaxLayout == 'bigger_input' and unitLabel %} ({{ unitLabel }}){% endif %}
                                        {% endblock %}

                                        {% block component_acris_filter_product_range_min_input %}
                                            <input class="form-control {% if filterType == 'range_min_max_slider' %}min-max-input-min{% else %}min-input{% endif %}"
                                                   type="number"
                                                   step="any"
                                                   data-type="min"
                                                   name="{{ minKey }}"
                                                   value="{{ currentMinValue }}"
                                                   min="{{ minValue }}"
                                                   placeholder="{{ minValue }}"
                                                   max="{{ maxValue }}">
                                        {% endblock %}

                                        {% block component_acris_filter_product_range_min_unit %}
                                            {% if minMaxLayout != 'bigger_input' and unitLabel %}
                                                <span class="filter-range-unit">{{ unitLabel }}</span>
                                            {% endif %}
                                        {% endblock %}
                                    </label>
                                {% endblock %}

                                {% block component_acris_filter_product_range_divider %}
                                    <div class="filter-range-divider">
                                        &ndash;
                                    </div>
                                {% endblock %}

                                {% block component_acris_filter_product_range_hidden_display_name %}
                                    <input type="hidden" name="displayName" value="{{ displayName }}">
                                {% endblock %}

                                {% block component_acris_filter_product_range_max %}
                                    <label class="filter-range-max">
                                        {% block component_acris_filter_product_range_max_label %}
                                            {{ 'listing.filterRangeMaxLabel'|trans|sw_sanitize }}{% if minMaxLayout == 'bigger_input' and unitLabel %} ({{ unitLabel }}){% endif %}
                                        {% endblock %}

                                        {% block component_acris_filter_product_range_max_input %}
                                            <input class="form-control {% if filterType == 'range_min_max_slider' %}min-max-input-max{% else %}max-input{% endif %}"
                                                   type="number"
                                                   step="any"
                                                   data-type="max"
                                                   name="{{ maxKey }}"
                                                   value="{{ currentMaxValue }}"
                                                   min="{{ minValue }}"
                                                   placeholder="{{ maxValue }}"
                                                   max="{{ maxValue }}">
                                        {% endblock %}

                                        {% block component_acris_filter_product_range_max_unit %}
                                            {% if minMaxLayout != 'bigger_input' and unitLabel %}
                                                <span class="filter-range-unit">{{ unitLabel }}</span>
                                            {% endif %}
                                        {% endblock %}
                                    </label>
                                {% endblock %}
                            </div>
                        {% endblock %}
                    {% endif %}

                    {% if filterType != 'range_min_max' %}
                        {% block component_acris_filter_product_range_slider %}
                            <div class="filter-range-slider-container w-100" data-name="{{ displayName }}">

                                {% block component_acris_filter_product_range_slider_inputs %}
                                    <input class="form-control min-input" type="hidden" name="{{ minKey }}" value="{{ currentMinValue }}">
                                    <input class="form-control max-input" type="hidden" name="{{ maxKey }}" value="{{ currentMaxValue }}">
                                {% endblock %}

                                {% block component_acris_filter_product_range_slider_wrapper %}
                                    <div class="acris-range-slider range-slider">
                                        <div class="range-slider-bar">
                                            <div class="range-slider-button range-slider-button-left"></div>
                                            <div class="range-slider-button range-slider-button-right"></div>
                                        </div>
                                    </div>
                                {% endblock %}

                                {% block component_acris_filter_product_range_slider_info %}
                                    <div class="acris-range-slider-info">
                                        <span class="acris-range-info-from">{{ 'acrisFilter.filterRangeSliderFrom'|trans|sw_sanitize }}</span>
                                        <span class="acris-range-info-value">
                                            <span id="acris-range-info-min" class="acris-range-info-value-from">{% if currentMinValue %}{{ currentMinValue }}{% else %}{{ minValue }}{% endif %}</span> {{ unitLabel }}
                                        </span>

                                        <span class="acris-range-info-to">{{ 'acrisFilter.filterRangeSliderTo'|trans|sw_sanitize }}</span>
                                        <span class="acris-range-info-value">
                                            <span id="acris-range-info-max" class="acris-range-info-value-to">{% if currentMaxValue %}{{ currentMaxValue }}{% else %}{{ maxValue }}{% endif %}</span> {{ unitLabel }}
                                        </span>
                                    </div>
                                {% endblock %}
                            </div>
                        {% endblock %}
                    {% endif %}
                </div>
            </div>
        {% endblock %}
    </div>
{% endblock %}
