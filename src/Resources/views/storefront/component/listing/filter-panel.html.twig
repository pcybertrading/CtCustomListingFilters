{% sw_extends '@Storefront/storefront/component/listing/filter-panel.html.twig' %}

{% block component_filter_panel_element %}
    {{ dump(listing) }}
    {{ parent() }}
{% endblock %}

{% block component_filter_panel_items %}
    {% block component_filter_panel_item_manufacturer %}
        {{ parent() }}
    {% endblock %}

    {% block component_filter_panel_item_delivery_time %}
        {# @var deliveryTimes \Shopware\Core\Framework\DataAbstractionLayer\Search\AggregationResult\Metric\EntityResult #}
        {% set deliveryTimes = listing.aggregations.get('deliveryTime') %}
        {% if not deliveryTimes.entities is empty %}
            {% set deliveryTimesSorted = deliveryTimes.entities|sort((a, b) => a.translated.name|lower <=> b.translated.name|lower) %}

            {% sw_include '@Storefront/storefront/component/listing/filter/filter-multi-select.html.twig' with {
                elements: deliveryTimesSorted,
                sidebar: sidebar,
                name: 'deliveryTime',
                displayName: 'listing.filterDeliveryTimeDisplayName'|trans|sw_sanitize,
                ariaLabel: 'listing.filterByDeliveryTimeAriaLabel'|trans|sw_sanitize
            } %}
        {% endif %}
    {% endblock %}

    {% block component_filter_panel_item_category %}
        {# @var categories \Shopware\Core\Framework\DataAbstractionLayer\Search\AggregationResult\Metric\EntityResult #}
        {% set categories = listing.aggregations.get('categories') %}
        {% if not categories.entities is empty %}
            {% sw_include '@Storefront/storefront/component/listing/filter/filter-multi-select.html.twig' with {
                elements: categories,
                sidebar: sidebar,
                name: 'categories',
                displayName: 'listing.filterDeliveryTimeDisplayName'|trans|sw_sanitize,
                ariaLabel: 'listing.filterByDeliveryTimeAriaLabel'|trans|sw_sanitize
            } %}
        {% endif %}
    {% endblock %}

    {% block component_filter_panel_item_properties %}{% endblock %}

    {% block component_filter_panel_item_rating_select %}{% endblock %}
{% endblock %}
