{% sw_extends '@Storefront/storefront/component/listing/filter-panel.html.twig' %}

{% block component_filter_panel_element %}
    {{ dump(listing) }}
    {{ parent() }}
{% endblock %}

{% block component_filter_panel_items_container %}
    {% if acrisFilterIgnoreShowMoreFilters == false %}
        <div data-acris-speaking-filter="{{ config('AcrisFilterCS.config.urlFilterParameter') }}" hidden="hidden"></div>

        {% if listing.extensions.acrisFilter.sortedFilters %}
            {% block acris_filter_show_more_button_offcanvas_content %}
                {% sw_include '@AcrisFilterCS/storefront/component/listing/acris-filter-panel.html.twig' with {
                    listing: listing,
                    sidebar: sidebar,
                    showOffcanvas: config('AcrisFilterCS.config.filterDisplayBehavior') == 'offcanvas',
                    isOffcanvas: isOffcanvas
                } %}
            {% endblock %}
        {% else %}
            {{ parent() }}
        {% endif %}
    {% else %}
        {{ parent() }}
    {% endif %}

{% endblock %}

{% block component_filter_panel_active_container %}
    {% if acrisFilterIgnoreShowMoreFilters == false %}
        {% if config('AcrisFilterCS.config.showActiveFilter') and config('AcrisFilterCS.config.filterDisplayBehavior') == "offcanvas" %}
            <div class="filter-panel-active-container{% if config('AcrisFilterCS.config.showActiveFilter') %} hide-in-panel{% endif %}"></div>
        {% elseif config('AcrisFilterCS.config.showActiveFilter') and config('AcrisFilterCS.config.filterDisplayBehavior') == "dropdown" %}
        {% else %}
            {{ parent() }}
        {% endif %}

        {% block component_filter_panel_offcanvas_buttons %}
            <div class="filter-panel-offcanvas-buttons">
                {% if config('AcrisFilterCS.config.showProductsBtn') %}
                    {% block component_filter_panel_offcanvas_acris_button_products %}
                        <div class="acris-filter-panel-btn-products btn btn-primary w-100 btn-lg text-center filter-panel-offcanvas-close js-offcanvas-close mt-2">
                            {% if config('AcrisFilterCS.config.filterProductCount') != "hide" %}
                                <span class="acris-filter-listing-product-count">
                                 {% if listing.count == 1 %}
                                     {{ "acrisFilter.buttonMobileProductsWithNumberSingle"|trans|striptags }}
                                 {% else %}
                                     {{ 'acrisFilter.buttonMobileProductsWithNumberMultiple'|trans({'%count%': listing.total})|sw_sanitize }}
                                 {% endif %}
                                </span>
                            {% else %}
                                {{ "acrisFilter.buttonMobileProducts"|trans|striptags }}
                            {% endif %}
                        </div>
                    {% endblock %}
                {% endif %}
                {% if config('AcrisFilterCS.config.showFilterBtn') %}
                    {% block component_filter_panel_offcanvas_acris_button_close %}
                        <div class="acris-filter-panel-btn-reset btn btn-secondary w-100 btn-lg text-center acris-filter-d-none mt-2">
                            {{ "acrisFilter.buttonMobileClose"|trans|striptags }}
                        </div>
                    {% endblock %}
                {% endif %}

            </div>
        {% endblock %}
    {% else %}
        {{ parent() }}
    {% endif %}

{% endblock %}
